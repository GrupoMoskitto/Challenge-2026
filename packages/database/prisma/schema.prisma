generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  phone           String
  cpf             String     @unique
  source          String
  status          LeadStatus @default(NEW)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  notes           String?
  origin          String?
  preferredDoctor String?
  procedure       String?
  whatsappActive  Boolean    @default(false)
  deletedAt       DateTime?
  contacts        Contact[]
  patient         Patient?

  @@index([cpf])
  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([deletedAt])
}

model Patient {
  id            String        @id @default(cuid())
  leadId        String        @unique
  dateOfBirth   DateTime?
  medicalRecord String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  address       String?
  deletedAt     DateTime?
  height        Float?
  howMet        String?
  sex           String?
  weight        Float?
  appointments  Appointment[]
  auditLogs     AuditLog[]
  budgets       Budget[]
  complaints    Complaint[]
  documents     Document[]
  lead          Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  postOps       PostOp[]

  @@index([leadId])
  @@index([deletedAt])
}

model Surgeon {
  id                  String                  @id @default(cuid())
  name                String
  specialty           String
  crm                 String                  @unique
  email               String                  @unique
  phone               String
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  appointmentDuration Int                     @default(30)
  appointments        Appointment[]
  availability        AvailabilitySlot[]
  budgets             Budget[]
  extraAvailability   ExtraAvailabilitySlot[]
  blocks              ScheduleBlock[]

  @@index([crm])
}

model AvailabilitySlot {
  id        String   @id @default(cuid())
  surgeonId String
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  surgeon   Surgeon  @relation(fields: [surgeonId], references: [id], onDelete: Cascade)

  @@index([surgeonId])
  @@index([dayOfWeek])
}

model ExtraAvailabilitySlot {
  id        String   @id @default(cuid())
  surgeonId String
  date      DateTime
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  surgeon   Surgeon  @relation(fields: [surgeonId], references: [id], onDelete: Cascade)

  @@index([surgeonId])
  @@index([date])
}

model ScheduleBlock {
  id        String   @id @default(cuid())
  surgeonId String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  surgeon   Surgeon  @relation(fields: [surgeonId], references: [id], onDelete: Cascade)

  @@index([surgeonId])
  @@index([startDate])
}

model Appointment {
  id            String            @id @default(cuid())
  patientId     String
  surgeonId     String
  procedure     String
  scheduledAt   DateTime
  status        AppointmentStatus @default(SCHEDULED)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  patient       Patient           @relation(fields: [patientId], references: [id])
  surgeon       Surgeon           @relation(fields: [surgeonId], references: [id])
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([patientId])
  @@index([surgeonId])
  @@index([scheduledAt])
  @@index([status])
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  role      UserRole   @default(CALL_CENTER)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  password  String
  auditLogs AuditLog[]

  @@index([email])
  @@index([role])
}

model AuditLog {
  id            String       @id @default(cuid())
  entityType    String
  entityId      String
  action        String
  oldValue      Json?
  newValue      Json?
  reason        String?
  userId        String?
  appointmentId String?
  createdAt     DateTime     @default(now())
  patientId     String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  patient       Patient?     @relation(fields: [patientId], references: [id])
  user          User?        @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([appointmentId])
  @@index([patientId])
  @@index([createdAt])
}

model Notification {
  id            String             @id @default(cuid())
  appointmentId String?
  postOpId      String?
  type          NotificationType
  status        NotificationStatus @default(PENDING)
  sentAt        DateTime?
  errorMessage  String?
  createdAt     DateTime           @default(now())
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  postOp        PostOp?            @relation(fields: [postOpId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([postOpId])
  @@index([status])
  @@index([type])
}

model Contact {
  id        String           @id @default(cuid())
  leadId    String
  date      DateTime
  type      ContactType
  direction ContactDirection
  status    ContactStatus
  message   String
  createdAt DateTime         @default(now())
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([date])
}

model Document {
  id        String         @id @default(cuid())
  patientId String
  name      String
  type      DocumentType
  date      DateTime
  status    DocumentStatus @default(PENDING)
  createdAt DateTime       @default(now())
  fileType  String?
  fileUrl   String?
  patient   Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model PostOp {
  id          String       @id @default(cuid())
  patientId   String
  date        DateTime
  type        PostOpType
  description String
  status      PostOpStatus @default(SCHEDULED)
  createdAt   DateTime     @default(now())
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([patientId])
  @@index([date])
}

model MessageTemplate {
  id          String         @id @default(cuid())
  name        String         @unique
  channel     MessageChannel
  content     String
  triggerDays Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Budget {
  id             String           @id @default(cuid())
  patientId      String
  surgeonId      String
  procedure      String
  amount         Float
  returnDeadline DateTime?
  status         BudgetStatus     @default(OPEN)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  surgeon        Surgeon          @relation(fields: [surgeonId], references: [id], onDelete: Cascade)
  followUps      BudgetFollowUp[]

  @@index([patientId])
  @@index([surgeonId])
  @@index([status])
}

model BudgetFollowUp {
  id          String   @id @default(cuid())
  budgetId    String
  date        DateTime
  notes       String?
  respondedBy String?
  createdAt   DateTime @default(now())
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model Complaint {
  id               String          @id @default(cuid())
  patientId        String
  area             String
  description      String
  status           ComplaintStatus @default(OPEN)
  responseDeadline DateTime?
  resolution       String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  patient          Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatments       Treatment[]

  @@index([patientId])
  @@index([status])
  @@index([area])
}

model Treatment {
  id          String    @id @default(cuid())
  complaintId String
  date        DateTime
  sector      String
  description String
  solution    String?
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([date])
}

model SlotLock {
  id        String   @id @default(cuid())
  surgeonId String
  date      DateTime
  startTime String
  jid       String
  expiresAt DateTime

  @@index([surgeonId, date, startTime])
  @@index([expiresAt])
}

model WhatsappSession {
  id                 String    @id @default(cuid())
  jid                String    @unique
  stage              String
  data               Json
  lastVerificationAt DateTime?
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([jid])
  @@index([expiresAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ATTENTION_REQUIRED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BudgetStatus {
  OPEN
  IN_PROGRESS
  CONTRACT_SIGNED
  CLOSED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TreatmentStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

enum UserRole {
  ADMIN
  SURGEON
  CALL_CENTER
  RECEPTION
  SALES
}

enum NotificationType {
  REMINDER_30D
  REMINDER_7D
  CONFIRMATION_48H
  POST_OP_CONFIRMATION
  LAST_ATTEMPT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum ContactType {
  WHATSAPP
  CALL
  EMAIL
}

enum ContactDirection {
  INBOUND
  OUTBOUND
}

enum ContactStatus {
  SENT
  DELIVERED
  READ
  FAILED
  ANSWERED
  MISSED
}

enum DocumentType {
  CONTRACT
  TERM
  EXAM
  OTHER
}

enum DocumentStatus {
  PENDING
  SIGNED
  UPLOADED
}

enum PostOpType {
  RETURN
  REPAIR
  PHONE_CALL
}

enum PostOpStatus {
  SCHEDULED
  CONFIRMED
  ATTENTION_REQUIRED
  COMPLETED
  PENDING
}

enum MessageChannel {
  WHATSAPP
  SMS
  EMAIL
}
